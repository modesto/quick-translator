<Window x:Class="QuickTranslator.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Translator"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="456" FontSize="13">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Border CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="8" Padding="14,12" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Original" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                               VerticalAlignment="Top" Margin="0,2,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="TargetButton" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="OnTargetClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE774;" VerticalAlignment="Center" />
                            <TextBlock x:Name="TargetBadge" FontSize="10" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="OnCloseClick">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <Border Height="1" Margin="0,10" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProviderTitle" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="ProviderSubtitle" Grid.Column="1" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="ElapsedText" Grid.Column="2" FontSize="12" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>

                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="64" Height="4" VerticalAlignment="Center" />
                    <TextBlock x:Name="LoadingText" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="FailurePanel">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource Icons}" Text="&#xE7BA;" Margin="0,2,8,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="FailureMessage" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="SettingsButton" Margin="0,0,8,0" Padding="10,3" Click="OnSettingsClick" />
                        <Button x:Name="RetryButton" Padding="10,3" Click="OnRetryClick" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="VariantsPanel" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
